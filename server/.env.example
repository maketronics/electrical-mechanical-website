# MongoDB (Atlas) — use Database → Connect → Drivers; replace password if it contains special chars (URL-encode)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/maketronics?retryWrites=true&w=majority

PORT=3001

# Gmail / Google Workspace: use an App Password, not your normal login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Where enquiries are delivered
ADMIN_EMAIL=info@make-tronics.com

# Optional: "From" can differ from SMTP_USER on some providers
# FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Maketronics
