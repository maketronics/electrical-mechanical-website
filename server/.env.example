# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-workspace-email@yourdomain.com
SMTP_PASS=your-app-password-here

# Custom "From" email address (shown to users)
# This is the email address that will appear in the "From" field for recipients
# You can use a different email or alias (e.g., noreply@yourdomain.com, info@yourdomain.com)
# If not set, it will use SMTP_USER
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Maketronics

# Admin Email (where form submissions will be sent)
ADMIN_EMAIL=admin@yourdomain.com

# Server Port
PORT=3001
